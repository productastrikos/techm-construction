# Public backend URLs (no secrets). Vite inlines these at BUILD time - rebuild after changing.
# Production values live in .env.production (committed on purpose; they are public URLs).
# REST API base URL of the integration hub (server/, port 4333 behind nginx :8443)
VITE_API_URL=https://techm-construction-api.astrikos.xyz:8443
# Websocket base URL (same host/port as the API - one backend, one port; path is /ws)
VITE_SOCKET_URL=https://techm-construction-api.astrikos.xyz:8443
